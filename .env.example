# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side AI Coach Keys (used by backend AI /api/chat endpoint)
# Option 1: Groq API Key (Recommended - Free & Ultra Fast from https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here

# Option 2: Google Gemini LLM API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Server Port (for standalone node production server)
PORT=3000
